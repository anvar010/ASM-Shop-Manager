# Copy to .env.local and fill in. Never commit the filled-in file.
# On Vercel these go under Settings → Environment Variables.

DB_HOST=
DB_PORT=3306
DB_NAME=asm
DB_USER=asm_user
DB_PASSWORD=
DB_SSL=false

# Generate with: openssl rand -base64 48
AUTH_SECRET=

# --- Mail (SMTP). Leave SMTP_HOST empty to disable sending. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_REPLY_TO=

ADMIN_EMAIL=

# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Push a reminder when one credit customer owes at least this many rupees.
# Unset means 5000; 0 turns the reminders off.
CREDIT_LIMIT=5000

# Lets the daily scheduler call /api/cron/credit-reminders. Any long random
# string; Vercel sends it as a Bearer token. Without it the endpoint refuses.
CRON_SECRET=
